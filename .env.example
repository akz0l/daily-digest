# Next.js frontend — copy this file to .env and fill in your values

# URL base del API Gateway (sin trailing slash)
# Ejemplo: https://abc123def.execute-api.us-east-1.amazonaws.com/prod/api
OTP_API_ENDPOINT=https://<api-id>.execute-api.<region>.amazonaws.com/<stage>/api

# API key configurada en el Usage Plan de API Gateway
OTP_API_KEY=your-api-gateway-key-here
